# Copy this file to .env and fill in your real values to enable the AI features.
# docker-compose reads .env automatically; .env is gitignored.

# Get an API key at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Optional — defaults to claude-haiku-4-5-20251001 if unset.
# Other valid options: claude-sonnet-4-6, claude-opus-4-7
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
